# requestEth 部署环境变量示例
# 复制为 .env 并填写实际值：cp .env.example .env

# === 数据库 ===
# 生产库已有大表时，GORM AutoMigrate 可能极慢或长时间锁表，导致 API 一直无法监听 HTTP。
# 表结构已就绪时可设为 1 跳过启动时迁移（升级表结构时请临时改回 0 或单独跑迁移）。
# REQUESTETH_SKIP_AUTOMIGRATE=1

# 清库或游标为 0 时，可设全链扫块统一起点（如 94360137），使下一格从该值+1 开始；生产有历史游标时勿乱设。设为 0 或未设置则关闭。
# REQUESTETH_SCAN_BASE_BLOCK=0
# 覆盖 data.database.source（本机 XAMPP 不把密码写进 yaml 时用），例：root:pass@tcp(127.0.0.1:3306)/game_nft_local?parseTime=true
# REQUESTETH_DATABASE_SOURCE=

# === 合约地址（正式版建议直接填写）===
# ETH_NFT_CONTRACT=0x169c4E946909D4E115b724957e5D1c74d0971f70
# ETH_STAKE_CONTRACT=0x907F84e4127049bB65C82F50CE29c1FF67f344D5
# ETH_SWAP_CONTRACT=0x3c9Ea8d476eA06108283457B3Bb0dfbfD6cf1A1b
# ETH_PRIMARY_MARKET_CONTRACT=0xdA5A5BC6b61B2eAB091A1b7E4d84C7eb537BDC0e
# ETH_VAULT_FACTORY_CONTRACT=0x7AD5C447580A79e072bFD72E373f7b25dDE0F061
# ETH_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# BSC RPC（逗号分隔，前者优先）。若同时配置 ETH_BSC_RPC_URLS 与 ETH_BSC_RPC_URLS_POLLING，读链 /sync 等会先尝试前者整表再尝试后者，自购节点请放在 ETH_BSC_RPC_URLS 最前。
# 只用 Allnodes：只填下面一行即可（不要加 bsc-dataseed）；事件扫链会沿用同一列表，无需再配 ETH_BSC_RPC_URLS_POLLING。
# ETH_BSC_RPC_URLS=https://your-host.allnodes.me:8545/YOUR_KEY
# 若扫链与交易要用不同节点，再单独设：ETH_BSC_RPC_URLS_POLLING=https://...
# ETH_DEPLOY_BLOCK_NFT_MINT=87620000  # 铸造事件起始块，BscScan 合约页查看创建块高
# ETH_DEPLOY_BLOCK_NFT_TRANSFER=87620000  # 可选；不填则与 ETH_DEPLOY_BLOCK_NFT_MINT 相同（务必与当前 NFT 合约部署块一致，否则转让不同步）

# === API 私钥 ===
# AICAT_ADMIN_PRIVATE_KEY=        # AICAT 相关接口
# SET_REWARD_ADMIN_PRIVATE_KEY=   # SetReward/SetRewardTwo
# REFERRAL_PAYOUT_PRIVATE_KEY=    # 铸造分佣打款
# REFERRAL_USDT_ADDR=             # 分佣打款 USDT 合约地址

# === Workers ===
# blind_settle_worker
# ETH_RPC_URL=https://bsc-dataseed4.binance.org/
# NFT_ADDR=0x169c4E946909D4E115b724957e5D1c74d0971f70
# BLIND_SETTLE_PRIVATE_KEY=

# referral_worker
# ETH_RPC_URL=
# NFT_ADDR=0x169c4E946909D4E115b724957e5D1c74d0971f70
# STAKE_ADDR=0x907F84e4127049bB65C82F50CE29c1FF67f344D5
# DATABASE_SOURCE=root:password@tcp(mysql:3306)/game?parseTime=true

# rebalance_worker
# ETH_RPC_URL=
# NFT_ADDR=0x169c4E946909D4E115b724957e5D1c74d0971f70
# USDT_ADDR=0x55d398326f99059fF775485246999027B3197955
# ACCOUNT_A_ADDR=
# EXCHANGE_ADDR=0x3c9Ea8d476eA06108283457B3Bb0dfbfD6cf1A1b
# REBALANCE_PRIVATE_KEY=
